// Copy to Config/Secrets.xcconfig (git-ignored) and fill in.
// Note: in .xcconfig files "//" starts a comment, so URLs are not supported here.

FLOW_BUNDLE_ID = com.yourname.flow
DEVELOPMENT_TEAM = ABCDE12345
FLOW_TMDB_API_KEY = your-tmdb-v3-key-or-v4-read-token
FLOW_TRAKT_CLIENT_ID = your-trakt-client-id
// Trakt only issues a client ID now (it signs in with PKCE), so the secret can stay empty. It is only
// for an older Trakt app that still has one; Flow sends it when set and works without it.
FLOW_TRAKT_CLIENT_SECRET =
FLOW_SIMKL_CLIENT_ID = your-simkl-client-id
FLOW_TVDB_API_KEY = your-tvdb-v4-key
