{
 "area": "source-parser",
 "description": "Quality traits read from free-form stream text, season and episode from a file name, titles and sizes (docs/SOURCE_LINKS.md, web/README.md): FlowKit's StreamParser and web/src/lib/sources/parser.ts. A parse case checks only the fields it names.",
 "cases": [
  {
   "name": "a UHD remux with Dolby Vision, HDR, HEVC and TrueHD Atmos",
   "op": "parse",
   "input": [
    "Dune.Part.Two.2024.2160p.UHD.BluRay.REMUX.HDR.DV.HEVC.TrueHD.Atmos.7.1-FraMeSToR.mkv"
   ],
   "expected": {
    "resolution": 2160,
    "quality": "REMUX",
    "videoCodec": "HEVC",
    "hdr": [
     "DV",
     "HDR"
    ],
    "audioCodec": "TrueHD Atmos",
    "audioChannels": "7.1",
    "releaseGroup": "framestor"
   }
  },
  {
   "name": "a web release with DDP, Atmos and H.264",
   "op": "parse",
   "input": [
    "Movie.2020.1080p.WEB-DL.DDP5.1.Atmos.H.264-NTb.mkv"
   ],
   "expected": {
    "resolution": 1080,
    "quality": "WEB-DL",
    "videoCodec": "H264",
    "hdr": [],
    "audioCodec": "Atmos",
    "audioChannels": "5.1",
    "releaseGroup": "ntb"
   }
  },
  {
   "name": "an add-on's three-line description: resolution, HDR, size and seeders",
   "op": "parse",
   "input": [
    "Torrentio\n4k DV | HDR\nDune Part Two (2024) 2160p WEB-DL DDP5.1 Atmos HEVC\n👤 123 💾 18.5 GB ⚙️ ThePirateBay"
   ],
   "expected": {
    "resolution": 2160,
    "quality": "WEB-DL",
    "hdr": [
     "DV",
     "HDR"
    ],
    "audioCodec": "Atmos",
    "seeders": 123,
    "sizeBytes": 19864223744,
    "videoCodec": "HEVC"
   }
  },
  {
   "name": "pieces are joined and a missing piece is skipped",
   "op": "parse",
   "input": [
    "Show S01E02",
    null,
    "Show.S01E02.720p.HDTV.x264-LOL.mkv"
   ],
   "expected": {
    "resolution": 720,
    "quality": "HDTV",
    "videoCodec": "H264",
    "releaseGroup": "lol"
   }
  },
