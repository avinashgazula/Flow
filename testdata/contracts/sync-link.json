{
 "area": "sync-link",
 "description": "Marquee Sync's pairing link and server address (docs/SYNC.md, Pairing): the apps' flow://sync link and the website's #sync= fragment, built and read, and a Worker address tidied to its origin. Keys are lower-case hex bytes; a refused link is null. A key with no server in it (a link without one, or the key alone) joins the build's own server (parseWithDefault); with none of its own it is refused.",
 "cases": [
  { "name": "the app link carries the key, the server and the token", "op": "appLink", "input": { "key": "8f3a1c5de2b7460971a4c0de5b2f9e63", "server": "https://flow-stream-proxy.example.workers.dev", "token": "tok123" }, "expected": "flow://sync?k=HWX1RQF2PX30JWD4R3F5PBWYCC&s=https%3A%2F%2Fflow-stream-proxy.example.workers.dev&t=tok123" },
  { "name": "a token is percent-encoded as encodeURIComponent writes it", "op": "appLink", "input": { "key": "8f3a1c5de2b7460971a4c0de5b2f9e63", "server": "https://x.dev", "token": "a b&c=d/é+!'()*~" }, "expected": "flow://sync?k=HWX1RQF2PX30JWD4R3F5PBWYCC&s=https%3A%2F%2Fx.dev&t=a%20b%26c%3Dd%2F%C3%A9%2B!'()*~" },
  { "name": "an empty token leaves the field empty", "op": "appLink", "input": { "key": "00000000000000000000000000000000", "server": "https://x.dev", "token": "" }, "expected": "flow://sync?k=00000000000000000000000000&s=https%3A%2F%2Fx.dev&t=" },
  { "name": "the web link puts the same three values in the settings page's fragment", "op": "webLink", "input": { "key": "8f3a1c5de2b7460971a4c0de5b2f9e63", "server": "https://x.dev", "token": "tok", "site": "https://marquee.example/app/" }, "expected": "https://marquee.example/app/settings#sync=k=HWX1RQF2PX30JWD4R3F5PBWYCC&s=https%3A%2F%2Fx.dev&t=tok" },
  { "name": "a site address without a trailing slash gets one", "op": "webLink", "input": { "key": "8f3a1c5de2b7460971a4c0de5b2f9e63", "server": "https://x.dev", "token": "tok", "site": "https://marquee.example" }, "expected": "https://marquee.example/settings#sync=k=HWX1RQF2PX30JWD4R3F5PBWYCC&s=https%3A%2F%2Fx.dev&t=tok" },

  { "name": "an app link is read", "op": "parse", "input": "flow://sync?k=HWX1RQF2PX30JWD4R3F5PBWYCC&s=https%3A%2F%2Fx.dev&t=tok", "expected": { "key": "8f3a1c5de2b7460971a4c0de5b2f9e63", "server": "https://x.dev", "token": "tok" } },
  { "name": "a web link is read", "op": "parse", "input": "https://marquee.example/settings#sync=k=HWX1RQF2PX30JWD4R3F5PBWYCC&s=https%3A%2F%2Fx.dev&t=tok", "expected": { "key": "8f3a1c5de2b7460971a4c0de5b2f9e63", "server": "https://x.dev", "token": "tok" } },
  { "name": "the scheme and host of an app link may be upper case", "op": "parse", "input": "FLOW://SYNC?k=HWX1RQF2PX30JWD4R3F5PBWYCC&s=https%3A%2F%2Fx.dev&t=tok", "expected": { "key": "8f3a1c5de2b7460971a4c0de5b2f9e63", "server": "https://x.dev", "token": "tok" } },
  { "name": "the key in a link may carry dashes and be lower case", "op": "parse", "input": "flow://sync?k=hwx1-rqf2-px30-jwd4-r3f5-pbwy-cc&s=https%3A%2F%2Fx.dev&t=tok", "expected": { "key": "8f3a1c5de2b7460971a4c0de5b2f9e63", "server": "https://x.dev", "token": "tok" } },
  { "name": "surrounding whitespace is ignored", "op": "parse", "input": "  \nflow://sync?k=HWX1RQF2PX30JWD4R3F5PBWYCC&s=https%3A%2F%2Fx.dev&t=tok\n", "expected": { "key": "8f3a1c5de2b7460971a4c0de5b2f9e63", "server": "https://x.dev", "token": "tok" } },
  { "name": "a percent-encoded token is decoded, including UTF-8", "op": "parse", "input": "flow://sync?k=HWX1RQF2PX30JWD4R3F5PBWYCC&s=https%3A%2F%2Fx.dev&t=a%20b%26c%3Dd%C3%A9", "expected": { "key": "8f3a1c5de2b7460971a4c0de5b2f9e63", "server": "https://x.dev", "token": "a b&c=dé" } },
  { "name": "a plus in a token is a plus, not a space", "op": "parse", "input": "flow://sync?k=HWX1RQF2PX30JWD4R3F5PBWYCC&s=https%3A%2F%2Fx.dev&t=a+b", "expected": { "key": "8f3a1c5de2b7460971a4c0de5b2f9e63", "server": "https://x.dev", "token": "a+b" } },
  { "name": "a link without a token reads an empty token", "op": "parse", "input": "flow://sync?k=HWX1RQF2PX30JWD4R3F5PBWYCC&s=https%3A%2F%2Fx.dev", "expected": { "key": "8f3a1c5de2b7460971a4c0de5b2f9e63", "server": "https://x.dev", "token": "" } },
  { "name": "a server without a scheme gets https", "op": "parse", "input": "flow://sync?k=HWX1RQF2PX30JWD4R3F5PBWYCC&s=x.dev&t=tok", "expected": { "key": "8f3a1c5de2b7460971a4c0de5b2f9e63", "server": "https://x.dev", "token": "tok" } },
  { "name": "a server with a path is cut to its origin", "op": "parse", "input": "flow://sync?k=HWX1RQF2PX30JWD4R3F5PBWYCC&s=https%3A%2F%2FX.dev%2Fsome%2Fpath&t=tok", "expected": { "key": "8f3a1c5de2b7460971a4c0de5b2f9e63", "server": "https://x.dev", "token": "tok" } },
  { "name": "when a parameter appears twice the first one counts", "op": "parse", "input": "flow://sync?k=HWX1RQF2PX30JWD4R3F5PBWYCC&s=https%3A%2F%2Ffirst.dev&s=https%3A%2F%2Fsecond.dev&t=tok", "expected": { "key": "8f3a1c5de2b7460971a4c0de5b2f9e63", "server": "https://first.dev", "token": "tok" } },
  { "name": "a key that is too short is refused", "op": "parse", "input": "flow://sync?k=HWX1RQF2PX30&s=https%3A%2F%2Fx.dev&t=tok", "expected": null },
  { "name": "a server that is not http or https is refused", "op": "parse", "input": "flow://sync?k=HWX1RQF2PX30JWD4R3F5PBWYCC&s=ftp%3A%2F%2Fx.dev&t=tok", "expected": null },
  { "name": "a server with no host is refused", "op": "parse", "input": "flow://sync?k=HWX1RQF2PX30JWD4R3F5PBWYCC&s=https%3A%2F%2F&t=tok", "expected": null },
  { "name": "text that is not a link is refused", "op": "parse", "input": "hello", "expected": null },
  { "name": "another flow link is not a sync link", "op": "parse", "input": "flow://setup?k=HWX1RQF2PX30JWD4R3F5PBWYCC&s=https%3A%2F%2Fx.dev&t=tok", "expected": null },
  { "name": "an empty paste is refused", "op": "parse", "input": "", "expected": null },

  { "name": "an app link with no server joins this build's own server", "op": "parseWithDefault", "input": {"link": "flow://sync?k=HWX1RQF2PX30JWD4R3F5PBWYCC", "defaultServer": "https://own.example.dev"}, "expected": {"key": "8f3a1c5de2b7460971a4c0de5b2f9e63", "server": "https://own.example.dev", "token": ""} },
  { "name": "a web link with no server joins this build's own server", "op": "parseWithDefault", "input": {"link": "https://marquee.example/settings#sync=k=HWX1RQF2PX30JWD4R3F5PBWYCC", "defaultServer": "https://own.example.dev"}, "expected": {"key": "8f3a1c5de2b7460971a4c0de5b2f9e63", "server": "https://own.example.dev", "token": ""} },
  { "name": "an empty server field counts as no server", "op": "parseWithDefault", "input": {"link": "flow://sync?k=HWX1RQF2PX30JWD4R3F5PBWYCC&s=&t=tok", "defaultServer": "https://own.example.dev"}, "expected": {"key": "8f3a1c5de2b7460971a4c0de5b2f9e63", "server": "https://own.example.dev", "token": "tok"} },
  { "name": "a link with a token and no server keeps its token", "op": "parseWithDefault", "input": {"link": "flow://sync?k=HWX1RQF2PX30JWD4R3F5PBWYCC&t=a%20b", "defaultServer": "https://own.example.dev"}, "expected": {"key": "8f3a1c5de2b7460971a4c0de5b2f9e63", "server": "https://own.example.dev", "token": "a b"} },
  { "name": "a bare key joins this build's own server", "op": "parseWithDefault", "input": {"link": "hwx1-rqf2-px30-jwd4-r3f5-pbwy-cc", "defaultServer": "https://own.example.dev"}, "expected": {"key": "8f3a1c5de2b7460971a4c0de5b2f9e63", "server": "https://own.example.dev", "token": ""} },
  { "name": "this build's own server is tidied to its origin", "op": "parseWithDefault", "input": {"link": "flow://sync?k=HWX1RQF2PX30JWD4R3F5PBWYCC", "defaultServer": "Own.Example.dev/path"}, "expected": {"key": "8f3a1c5de2b7460971a4c0de5b2f9e63", "server": "https://own.example.dev", "token": ""} },
  { "name": "a server in the link beats this build's own", "op": "parseWithDefault", "input": {"link": "flow://sync?k=HWX1RQF2PX30JWD4R3F5PBWYCC&s=https%3A%2F%2Fx.dev&t=tok", "defaultServer": "https://own.example.dev"}, "expected": {"key": "8f3a1c5de2b7460971a4c0de5b2f9e63", "server": "https://x.dev", "token": "tok"} },
  { "name": "a link with no server is refused when this build has none", "op": "parseWithDefault", "input": {"link": "flow://sync?k=HWX1RQF2PX30JWD4R3F5PBWYCC&t=tok"}, "expected": null },
  { "name": "a link with no server is refused when this build's server is blank", "op": "parseWithDefault", "input": {"link": "flow://sync?k=HWX1RQF2PX30JWD4R3F5PBWYCC", "defaultServer": "  "}, "expected": null },
  { "name": "a bare key is refused when this build has no server", "op": "parseWithDefault", "input": {"link": "HWX1RQF2PX30JWD4R3F5PBWYCC"}, "expected": null },
  { "name": "a server that can't be read is refused, not replaced by this build's own", "op": "parseWithDefault", "input": {"link": "flow://sync?k=HWX1RQF2PX30JWD4R3F5PBWYCC&s=ftp%3A%2F%2Fx.dev", "defaultServer": "https://own.example.dev"}, "expected": null },
  { "name": "a key that is too short is refused even with a server to fall back on", "op": "parseWithDefault", "input": {"link": "flow://sync?k=HWX1RQF2PX30", "defaultServer": "https://own.example.dev"}, "expected": null },
  { "name": "text that is not a key or a link is refused even with a server to fall back on", "op": "parseWithDefault", "input": {"link": "hello", "defaultServer": "https://own.example.dev"}, "expected": null },

  { "name": "a bare host becomes an https origin", "op": "normalizeServer", "input": "example.com", "expected": "https://example.com" },
  { "name": "the path, query and trailing slash are dropped and the host is lower-cased", "op": "normalizeServer", "input": "https://Example.COM/some/path/?x=1", "expected": "https://example.com" },
  { "name": "a port is kept", "op": "normalizeServer", "input": "http://localhost:8787/", "expected": "http://localhost:8787" },
  { "name": "a bare host with a port and path", "op": "normalizeServer", "input": "x.dev:8443/path", "expected": "https://x.dev:8443" },
  { "name": "whitespace around the address is ignored", "op": "normalizeServer", "input": "  https://x.dev  ", "expected": "https://x.dev" },
  { "name": "an upper-case scheme is lower-cased", "op": "normalizeServer", "input": "HTTPS://X.DEV", "expected": "https://x.dev" },
  { "name": "the default port is dropped", "op": "normalizeServer", "input": "https://x.dev:443", "expected": "https://x.dev" },
  { "name": "port 80 is the default for http", "op": "normalizeServer", "input": "http://x.dev:80", "expected": "http://x.dev" },
  { "name": "port 80 is not the default for https", "op": "normalizeServer", "input": "https://x.dev:80", "expected": "https://x.dev:80" },
  { "name": "credentials in the address are dropped", "op": "normalizeServer", "input": "https://user:pass@x.dev/", "expected": "https://x.dev" },
  { "name": "an IPv6 address keeps its brackets", "op": "normalizeServer", "input": "http://[::1]:8787", "expected": "http://[::1]:8787" },
  { "name": "another scheme is refused", "op": "normalizeServer", "input": "ftp://x.dev", "expected": null },
  { "name": "an empty address is refused", "op": "normalizeServer", "input": "", "expected": null },
  { "name": "a blank address is refused", "op": "normalizeServer", "input": "   ", "expected": null },
  { "name": "a scheme with no host is refused", "op": "normalizeServer", "input": "https://", "expected": null }
]
}
