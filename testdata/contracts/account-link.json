{
 "area": "account-link",
 "description": "The link that logs an app in to a Marquee Account (docs/SYNC.md, The account link): flow://account?n=<16 digits>&s=<server origin>, built by the website and read by the apps. The number is written without spaces and the server is percent-encoded as encodeURIComponent writes it; a link that can't log anyone in is refused (null).",
 "cases": [
  { "name": "the link carries the digits and the server", "op": "appLink", "input": { "number": "1234567890123456", "server": "https://example.workers.dev" }, "expected": "flow://account?n=1234567890123456&s=https%3A%2F%2Fexample.workers.dev" },
  { "name": "a number as shown loses its spaces", "op": "appLink", "input": { "number": "1234 5678 9012 3456", "server": "https://example.workers.dev" }, "expected": "flow://account?n=1234567890123456&s=https%3A%2F%2Fexample.workers.dev" },
  { "name": "leading zeros are kept in the link", "op": "appLink", "input": { "number": "0000 0000 0000 0001", "server": "https://example.workers.dev" }, "expected": "flow://account?n=0000000000000001&s=https%3A%2F%2Fexample.workers.dev" },
  { "name": "a server with a port and no https is written as its origin", "op": "appLink", "input": { "number": "1234567890123456", "server": "http://localhost:8787/" }, "expected": "flow://account?n=1234567890123456&s=http%3A%2F%2Flocalhost%3A8787" },
  { "name": "a server typed without a scheme or with a path is cut to its origin", "op": "appLink", "input": { "number": "1234567890123456", "server": "Example.workers.dev/some/path" }, "expected": "flow://account?n=1234567890123456&s=https%3A%2F%2Fexample.workers.dev" },
  { "name": "a short number gets no link", "op": "appLink", "input": { "number": "1234 5678 9012 345", "server": "https://example.workers.dev" }, "expected": null },
  { "name": "a server that is not http or https gets no link", "op": "appLink", "input": { "number": "1234567890123456", "server": "ftp://example.workers.dev" }, "expected": null },
  { "name": "no server gets no link", "op": "appLink", "input": { "number": "1234567890123456", "server": "" }, "expected": null },

  { "name": "a link is read", "op": "parse", "input": "flow://account?n=1234567890123456&s=https%3A%2F%2Fexample.workers.dev", "expected": { "number": "1234567890123456", "server": "https://example.workers.dev" } },
  { "name": "the scheme and host may be upper case", "op": "parse", "input": "FLOW://ACCOUNT?n=1234567890123456&s=https%3A%2F%2Fexample.workers.dev", "expected": { "number": "1234567890123456", "server": "https://example.workers.dev" } },
  { "name": "the order of the parameters does not matter", "op": "parse", "input": "flow://account?s=https%3A%2F%2Fexample.workers.dev&n=1234567890123456", "expected": { "number": "1234567890123456", "server": "https://example.workers.dev" } },
  { "name": "surrounding whitespace is ignored", "op": "parse", "input": "  \nflow://account?n=1234567890123456&s=https%3A%2F%2Fexample.workers.dev\n", "expected": { "number": "1234567890123456", "server": "https://example.workers.dev" } },
  { "name": "leading zeros are kept when reading", "op": "parse", "input": "flow://account?n=0000000000000001&s=https%3A%2F%2Fexample.workers.dev", "expected": { "number": "0000000000000001", "server": "https://example.workers.dev" } },
  { "name": "a number with encoded spaces or dashes is read", "op": "parse", "input": "flow://account?n=1234%205678%209012%203456&s=https%3A%2F%2Fexample.workers.dev", "expected": { "number": "1234567890123456", "server": "https://example.workers.dev" } },
  { "name": "a number with dashes is read", "op": "parse", "input": "flow://account?n=1234-5678-9012-3456&s=https%3A%2F%2Fexample.workers.dev", "expected": { "number": "1234567890123456", "server": "https://example.workers.dev" } },
  { "name": "a server that is not encoded is read", "op": "parse", "input": "flow://account?n=1234567890123456&s=https://example.workers.dev", "expected": { "number": "1234567890123456", "server": "https://example.workers.dev" } },
  { "name": "a server without a scheme gets https", "op": "parse", "input": "flow://account?n=1234567890123456&s=example.workers.dev", "expected": { "number": "1234567890123456", "server": "https://example.workers.dev" } },
  { "name": "a server with a path and capitals is cut to its lower-case origin", "op": "parse", "input": "flow://account?n=1234567890123456&s=https%3A%2F%2FExample.Workers.dev%2Fsome%2Fpath%2F", "expected": { "number": "1234567890123456", "server": "https://example.workers.dev" } },
  { "name": "a server with a port keeps it", "op": "parse", "input": "flow://account?n=1234567890123456&s=http%3A%2F%2Flocalhost%3A8787", "expected": { "number": "1234567890123456", "server": "http://localhost:8787" } },
  { "name": "other parameters are ignored", "op": "parse", "input": "flow://account?utm=x&n=1234567890123456&s=https%3A%2F%2Fexample.workers.dev&t=tok", "expected": { "number": "1234567890123456", "server": "https://example.workers.dev" } },
  { "name": "a fragment is ignored", "op": "parse", "input": "flow://account?n=1234567890123456&s=https%3A%2F%2Fexample.workers.dev#top", "expected": { "number": "1234567890123456", "server": "https://example.workers.dev" } },
  { "name": "when a parameter appears twice the first one counts", "op": "parse", "input": "flow://account?n=1234567890123456&n=6543210987654321&s=https%3A%2F%2Ffirst.dev&s=https%3A%2F%2Fsecond.dev", "expected": { "number": "1234567890123456", "server": "https://first.dev" } },
  { "name": "a plus in a server stays a plus, not a space", "op": "parse", "input": "flow://account?n=1234567890123456&s=https%3A%2F%2Fexample.workers.dev%2Fa+b", "expected": { "number": "1234567890123456", "server": "https://example.workers.dev" } },
  { "name": "a link with no number is refused", "op": "parse", "input": "flow://account?s=https%3A%2F%2Fexample.workers.dev", "expected": null },
  { "name": "an empty number is refused", "op": "parse", "input": "flow://account?n=&s=https%3A%2F%2Fexample.workers.dev", "expected": null },
  { "name": "fifteen digits are refused", "op": "parse", "input": "flow://account?n=123456789012345&s=https%3A%2F%2Fexample.workers.dev", "expected": null },
  { "name": "seventeen digits are refused", "op": "parse", "input": "flow://account?n=12345678901234567&s=https%3A%2F%2Fexample.workers.dev", "expected": null },
  { "name": "a letter in the number is refused", "op": "parse", "input": "flow://account?n=123456789012345a&s=https%3A%2F%2Fexample.workers.dev", "expected": null },
  { "name": "a link with no server is refused", "op": "parse", "input": "flow://account?n=1234567890123456", "expected": null },
  { "name": "an empty server is refused", "op": "parse", "input": "flow://account?n=1234567890123456&s=", "expected": null },
  { "name": "a server that is not http or https is refused", "op": "parse", "input": "flow://account?n=1234567890123456&s=ftp%3A%2F%2Fexample.workers.dev", "expected": null },
  { "name": "a server with no host is refused", "op": "parse", "input": "flow://account?n=1234567890123456&s=https%3A%2F%2F", "expected": null },
  { "name": "a link with no parameters is refused", "op": "parse", "input": "flow://account", "expected": null },
  { "name": "a sync link is not an account link", "op": "parse", "input": "flow://sync?n=1234567890123456&s=https%3A%2F%2Fexample.workers.dev", "expected": null },
  { "name": "another scheme is refused", "op": "parse", "input": "https://account?n=1234567890123456&s=https%3A%2F%2Fexample.workers.dev", "expected": null },
  { "name": "text that is not a link is refused", "op": "parse", "input": "hello", "expected": null },
  { "name": "an empty paste is refused", "op": "parse", "input": "", "expected": null }
 ]
}
