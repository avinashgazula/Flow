# Copy this to wrangler.toml, change the values, then run `npx wrangler deploy`. See README.md.
name = "flow-stream-proxy"
main = "worker.js"
compatibility_date = "2025-01-01"

[vars]
# The addresses Flow is served from, comma-separated, with no trailing slash. Only these pages can
# read the proxy's answers. Add http://localhost:5173 while you develop.
ALLOWED_ORIGINS = "https://flow.example.com"

# The hosts the proxy may fetch from, comma-separated. A leading *. matches any subdomain.
# Not needed for OpenSubtitles (www.opensubtitles.com, dl.opensubtitles.org) or IntroDB (api.introdb.app): the Worker
# always allows those. Put your add-on's host (the play link) and the host it redirects to (your debrid service).
ALLOWED_HOSTS = "aiostreams.example.com,*.real-debrid.com"

# Optional. Hosts that are fine as the target of a redirect but not as a first request.
# ALLOWED_REDIRECT_HOSTS = "*.cdn.example.net"

# The access token is a secret, so it isn't set here. Run `npx wrangler secret put TOKEN`.

# Optional: Flow Sync. Run `npx wrangler kv namespace create SYNC`, then paste the id it prints here.
# Leave this block out and the proxy works as before; sync answers "Sync needs a KV namespace".
[[kv_namespaces]]
binding = "SYNC"
id = "PASTE_THE_ID_THAT_WRANGLER_PRINTED"

# Optional: Marquee Accounts (docs/SYNC.md) use the same SYNC namespace, and need ALLOWED_ORIGINS above to list the page.
# The Worker already counts failed requests per address in KV (20 in ten minutes, then 429). This adds Cloudflare's own
# Rate Limiting binding in front of that, as a flood brake of 100 requests a minute per address. Leave it out to use the KV
# counters alone. The namespace_id is any number you choose that is unique in your account.
# [[ratelimits]]
# name = "ACCOUNT_LIMITER"
# namespace_id = "1001"
# simple = { limit = 100, period = 60 }
