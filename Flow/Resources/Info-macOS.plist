	<string>$(FLOW_TVDB_API_KEY)</string>
	<key>FlowTraktClientID</key>
	<string>$(FLOW_TRAKT_CLIENT_ID)</string>
	<key>FlowTraktClientSecret</key>
	<string>$(FLOW_TRAKT_CLIENT_SECRET)</string>
